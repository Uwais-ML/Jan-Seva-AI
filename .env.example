# Server Configuration
HOST=0.0.0.0
PORT=8000

# Local / Remote LLM (OpenAI-compatible endpoint, e.g. LM Studio, Ollama, llama.cpp server)
OPENAI_BASE_URL=http://localhost:61619/v1
OPENAI_API_KEY=not-needed
DEFAULT_LLM_MODEL=Main_model

# Sarvam AI API for Indic STT (Saarika) & TTS (Bulbul)
# Get your API key from https://www.sarvam.ai
SARVAM_API_KEY=

# Database SQLite Path
DATABASE_URL=sqlite:///Database/assistant.db
